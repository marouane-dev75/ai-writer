{
  "name": "ai-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "depcruise": "depcruise src",
    "depcruise:graph": "depcruise src --output-type dot | dot -T svg > dependency-graph.svg",
    "depcruise:graph:png": "depcruise src --output-type dot | dot -T png > dependency-graph.png"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2.4.2",
    "@tauri-apps/plugin-opener": "^2",
    "i18next": "^25.6.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.3.5",
    "react-icons": "^5.5.0",
    "react-router": "^7.9.6",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@welldone-software/why-did-you-render": "^10.0.1",
    "dependency-cruiser": "^17.3.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
